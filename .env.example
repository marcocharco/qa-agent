# Copy to .env.local and fill in. Never commit .env.local.
TINYFISH_API_KEY=
GEMINI_API_KEY=
# Local Postgres (Homebrew postgresql@17), no password; uses your OS user
DATABASE_URL=postgres://localhost:5432/receipts
# Hosted pricing-page targets: planted bugs on, and the bug-free control
TARGET_URL=https://receipts-demo-buggy.vercel.app
TARGET_CONTROL_URL=https://receipts-demo-control.vercel.app
