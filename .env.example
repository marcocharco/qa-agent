# Copy to .env.local and fill in. Never commit .env.local.
TINYFISH_API_KEY=
GEMINI_API_KEY=
# Local Postgres (Homebrew postgresql@17), no password; uses your OS user
DATABASE_URL=postgres://localhost:5432/receipts
# Demo repo deployments: the buggy branch (live site) and the fixed build (green re-run, set once session 3 is deployed)
TARGET_URL=https://acme-pricing-demo.vercel.app
TARGET_CONTROL_URL=https://acme-pricing-demo-fixed.vercel.app
# Entire project (forge/owner) and the local clone where the Trail's sessions were recorded.
# The dashboard's "Run now" button hands these to scripts/orchestrate.mts.
ENTIRE_PROJECT=gh/your-owner
TARGET_REPO_DIR=/absolute/path/to/the/target/repo/clone
# Optional: how many TinyFish browsers run at once (default 4)
# CONCURRENCY=4
